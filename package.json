{
  "name": "construction-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --schema public,private --level warning --fail-on warning",
    "db:test:concurrency": "node scripts/test-concurrency.mjs",
    "db:test:api": "node scripts/test-api.mjs",
    "dev": "vite",
    "build": "node scripts/check-build-env.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src e2e playwright.config.ts",
    "test": "vitest run",
    "demo:prepare": "node scripts/prepare-demo.mjs",
    "test:e2e": "npm run demo:prepare && playwright test",
    "test:demo": "node --test scripts/demo-data.test.mjs",
    "test:deployment": "node --test scripts/build-env.test.mjs",
    "db:check:migrations": "node scripts/check-migrations-local.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "pg": "8.16.3",
    "supabase": "3.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.2",
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.106.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": "24.x"
  }
}
